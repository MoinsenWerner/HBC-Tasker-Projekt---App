            Context context = (Context) Class.forName("android.app.ActivityThread")
                .getMethod("currentApplication", null)
                .invoke(null, null);
                
            notificationManager = (NotificationManager) context.getSystemService(Context.NOTIFICATION_SERVICE);
            
            // Notification Channel für Android 8.0+ initialisieren
            if (Build.VERSION.SDK_INT &gt;= 26) {
                NotificationChannel channel = new NotificationChannel(channelId, "HBC Updates", NotificationManager.IMPORTANCE_LOW);
                notificationManager.createNotificationChannel(channel);
            }
            
            int iconId = context.getApplicationInfo().icon;
            Notification.Builder builder;
            if (Build.VERSION.SDK_INT &gt;= 26) {
                builder = new Notification.Builder(context, channelId);
            } else {
                builder = new Notification.Builder(context);
            }
            
            // Initiale Benachrichtigung aufbauen
            builder.setContentTitle("Downloading Update...")
                   .setSmallIcon(iconId)
                   .setOngoing(true)
                   .setProgress(100, 0, false);
                   
            notificationManager.notify(notificationId, builder.build());
            
            // Zielverzeichnis prüfen und bei Bedarf erstellen
            File file = new File(filePath);
            if (!file.getParentFile().exists()) {
                file.getParentFile().mkdirs();
            }
            
            // HTTP-Verbindung konfigurieren
            URL url = new URL(urlStr);
            connection = (HttpURLConnection) url.openConnection();
            connection.setConnectTimeout(15000);
            connection.setReadTimeout(15000);
            connection.connect();
            
            int fileLength = connection.getContentLength();
            input = new BufferedInputStream(connection.getInputStream(), 8192);
            output = new FileOutputStream(file);
            
            byte[] buffer = new byte[4096];
            long total = 0;
            int count;
            int lastUpdate = -5; // Throttling-Schwellenwert (Aktualisierung alle 5%)
            
            // Download-Schleife
            while ((count = input.read(buffer)) != -1) {
                total += count;
                output.write(buffer, 0, count);
                
                double downloadedMb = (double) total / 1048576.0;
                double roundedMb = Math.round(downloadedMb * 10.0) / 10.0;
                
                if (fileLength &gt; 0) {
                    int progress = (int) ((total * 100) / fileLength);
                    // UI-Updates drosseln, um System-Overhead zu minimieren
                    if (progress &gt;= lastUpdate + 5 || progress == 100) {
                        lastUpdate = progress;
                        builder.setProgress(100, progress, false)
                               .setContentText(progress + "% (" + roundedMb + " MB)");
                        notificationManager.notify(notificationId, builder.build());
                    }
                } else {
                    // Fallback-Modus ohne Prozentanzeige (falls Server Content-Length verbirgt)
                    builder.setProgress(100, 0, true)
                           .setContentText(roundedMb + " MB");
                    notificationManager.notify(notificationId, builder.build());
                }
            }
            
            output.flush();
            
        } catch (Exception e) {
            // Fehlerbehandlung im Hintergrund-Thread
        } finally {
            // Ressourcen-Bereinigung
